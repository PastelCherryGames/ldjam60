id = 0
info_blurb = "The Cybersaga (abbreviated as CS) was a video game console rumored to have been developed by Eidolon."

[sub_resource type="Resource" id="Resource_vpphb"]
script = ExtResource("4_b43q5")
id = 1
info_blurb = "The CS \"promised an revolutionary new gaming experience\"."

[sub_resource type="Resource" id="Resource_yys8v"]
script = ExtResource("4_b43q5")
id = 2
info_blurb = "The CS was planned to be released for the 2001 holiday season, but never made it to store shelves."

[sub_resource type="Resource" id="Resource_2ihq6"]
script = ExtResource("4_b43q5")
id = 3
info_blurb = "Eidolon was one of the biggest video game companies in the 1990s."

[sub_resource type="Resource" id="Resource_b3g5w"]
script = ExtResource("4_b43q5")
id = 4
info_blurb = "Eidolon was famous for hits such as Fortress Defender 2, Crazy Pineapple Guy, and Mystery of the Golden Mountains."

[sub_resource type="Resource" id="Resource_dwn85"]
script = ExtResource("4_b43q5")
id = 5
info_blurb = "Eidolon's CEO during the Cybersaga's development was Dave Brunswick."

[sub_resource type="Resource" id="Resource_ht8ty"]
script = ExtResource("4_b43q5")
id = 6
info_blurb = "The Cybersaga was made to run Eidolon's first in-house 3D games."

[sub_resource type="Resource" id="Resource_8uswj"]
script = ExtResource("4_b43q5")
id = 7
info_blurb = "The first and only game announced for the CS was KNIGHT, an action adventure title."

[sub_resource type="Resource" id="Resource_wypqq"]
script = ExtResource("4_b43q5")
id = 8
info_blurb = "Dave Brunswick claimed that Cybersaga games would offer an immersive experience \"almost indistinguishable from reality.\""

[sub_resource type="Resource" id="Resource_qinfc"]
script = ExtResource("4_b43q5")
id = 9
info_blurb = "Development on the Cybersaga began in 1998 after the success of the Game and Go and the release of popular 3D console games from Eidolon's competitors."

[sub_resource type="Resource" id="Resource_xxciq"]
script = ExtResource("4_b43q5")
id = 10
info_blurb = "Unusually, Dave Brunswick himself was a co-lead on the design team, even though he had no background in hardware development."

[sub_resource type="Resource" id="Resource_8h2gw"]
script = ExtResource("4_b43q5")
id = 11
info_blurb = "The Cybersaga's development was very secretive, and playtests were restricted to a small anonymous group of in-house QA testers."

[sub_resource type="Resource" id="Resource_el84a"]
script = ExtResource("4_b43q5")
id = 12
info_blurb = "Eidolon hid the reason for canceling the Cybersaga's release, even from close collaborators, and ensured that no information ever found its way to the public internet."

[sub_resource type="Resource" id="Resource_vcwvp"]
script = ExtResource("4_b43q5")
id = 13
info_blurb = "There are rumors about a disastrous pre-launch Cybersaga demo held for Eidolon's employees and their family. Some think it influenced the decision to cancel the release."

[sub_resource type="Resource" id="Resource_xkk4w"]
script = ExtResource("4_b43q5")
id = 14
info_blurb = "The Cybersaga's Saga Crystal malfunctioned at the Annual Appreciation Event, causing mass psychosis in the demo participants."

[sub_resource type="Resource" id="Resource_kq0p0"]
script = ExtResource("4_b43q5")
id = 15
info_blurb = "An ad in Game Design Now shows a partial view of the Cybersaga. Its most noticeable feature is a jagged purple crystal under a glass dome on the top of the console."

[sub_resource type="Resource" id="Resource_a2sex"]
script = ExtResource("4_b43q5")
id = 16
info_blurb = "The Cybersaga contained a Saga Crystal, a unique creation of the Eidolon labs. It enhanced the immersion of games by inducing hallucinations in players."

[sub_resource type="Resource" id="Resource_w7tor"]
script = ExtResource("4_b43q5")
id = 17
info_blurb = "Dave Brunswick personally dropped the only completed Cybersaga off of a cliff before retiring and buying an island. However, you now possess a copy of the plans."

