[sub_resource type="Resource" id="Resource_ou381"]
script = ExtResource("2_0ebsy")
id = 0
email_subject = "Have you heard of the Eidolon Cybersaga?"
email_from = "A Fan of Your Blog"
email_body = "Hey there!

I've been reading your blog for a while, and I love your deep dives into retro consoles. I remember playing on the Game and Go as a kid, so it was fun to see you mention it in your post last week!

Anyways,speaking of Eidolon consoles, do you have any information about the Cybersaga? I heard from a buddy of mine that it was some crazy new console that never got released before the company went under. I've been having trouble finding anything about it online other than rumors, so I thought I'd reach out and see if you know more.

Maybe you could even write a blog post about it!"
sent_index = 0

