[sub_resource type="Resource" id="Resource_72iso"]
script = ExtResource("3_b43q5")
id = 0
search_result_keywords = Array[String](["cybersaga"])
discoverable_infos = Array[int]([0])
search_result_text = "Your search yields little information. The Cybersaga, often abbreviated as CS on retro gaming forums, was a video game console rumored to have been developed by a company called Eidolon.

The company sounds familiar, but you've never heard of the Cybersaga before today. Maybe there's some more helpful information in the email you received?"

[sub_resource type="Resource" id="Resource_38bpc"]
script = ExtResource("3_b43q5")
id = 1
search_result_keywords = Array[String](["game and go"])
search_result_text = "The Game and Go was a wildly popular handheld console developed by Eidolon in the mid 1990s. By the end of its lifespan, it boasted a library of over 300 games, the last of which was a cute farming sim called Summer Fields.

According to an interview you found with Eidolon's head of hardware development, Heidi Schuman, the Game and Go was what really solidified the company's status as a household name."

[sub_resource type="Resource" id="Resource_yewyn"]
script = ExtResource("3_b43q5")
id = 2
search_result_keywords = Array[String](["heidi schuman"])
discoverable_infos = Array[int]([1])
search_result_text = "Heidi Schuman was Eidolon's head of hardware development from 1993 until their abrupt closing in 2002. Her last public appearance with the company was a press conference about the upcoming Cybersaga release.

You find a transcript of her talk, but Heidi stayed annoyingly vague throughout the entire thing. The most concrete thing she said was that the Cybersaga \"promised a revolutionary new gaming experience.\""

[sub_resource type="Resource" id="Resource_byh4l"]
script = ExtResource("3_b43q5")
id = 3
search_result_keywords = Array[String](["summer fields"])
discoverable_infos = Array[int]([2])
search_result_text = "Summer Fields is a series of farming sim games named after the titular main character. It takes some time to scroll past all of the results for the latest game in the series, but eventually you find a news article about the release of the original game during the holiday season of 2001.

Apparently, the game wasn't expected to sell very well, but intrigue surrounding the Cybersaga, which was supposed to launch around the same time, catapulted the game to cult classic status overnight.

You remember playing this game when you were younger. Despite the cute pixel art graphics, it was so difficult that you never made it past the first in-game week."

